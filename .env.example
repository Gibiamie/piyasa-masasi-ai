# Copy to .env and fill in real values locally. Never commit the real .env.
# See legacy-import/backend/market-gateway/.env.example for the gateway's own template.

# GitHub (only needed for scripted repo/administration operations; prefer `gh auth login` interactively)
GITHUB_TOKEN=

# Market data gateway (server-side only, never exposed to the browser)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
MIC_GATEWAY_TOKEN=
ALLOWED_ORIGINS=https://gibiamie.github.io
